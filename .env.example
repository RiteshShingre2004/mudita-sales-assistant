# Copy to .env for local runs. Never commit real values.
APP_ENV=development
DATABASE_URL=sqlite:///./local.db
PUBLIC_BASE_URL=http://localhost:8000

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REPLY_MODEL=openai/gpt-oss-20b

# Gmail + Google Calendar (Step 2 and Step 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only mail sent here is treated as an inquiry (protects a personal mailbox)
EMAIL_INBOX_ADDRESS=you+lumen@gmail.com
# Calendar used for availability and bookings (a dedicated test calendar's ID is best)
GOOGLE_CALENDAR_ID=primary

# WhatsApp Cloud API + Instagram Messaging (Step 5 and Step 6)
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
